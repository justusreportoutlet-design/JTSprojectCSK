rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPERS ---
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'christiankaian631@gmail.com' ||
          request.auth.token.email.lower() == 'walelengfindy@gmail.com' ||
          request.auth.token.email.lower() == 'workingeveryday93@gmail.com' ||
          request.auth.token.email.lower() == 'jtsreportbdg@gmail.com' ||
          request.auth.token.email.lower() == 'justusreportoutlet@gmail.com'
        ))
      ); 
    }
    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_ ()&.,/\'-]+$');
    }

    // --- PROJECT BARU christian-project-3cf5c - VERSI IRIT ---
    
    match /laporan/{docId} {
      allow get, list: if true; // biar getDataIrit() bisa jalan, cuma 20 reads
      allow create, update: if isValidId(docId);
      allow delete: if isAdmin();
    }

    match /dashboards/{outletId} {
      allow get, list: if true;
      allow create, update: if isValidId(outletId);
      allow delete: if isAdmin();
    }

    match /system_data/{docId} {
      allow get, list: if true;
      allow create, update: if isValidId(docId);
      allow delete: if isAdmin();
    }

    match /system_config/{docId} {
      allow get, list: if true;
      allow create, update: if isValidId(docId);
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow get, list: if true;
      allow create: if isValidId(notificationId);
      allow update, delete: if isAdmin();
    }

    match /presence/{userId} {
      allow get, list: if true;
      allow create, update: if userId == request.auth.uid || isAdmin() || true;
      allow delete: if true;
    }

    match /chat_messages/{messageId} {
      allow get, list: if true;
      allow create: if isValidId(messageId);
      allow update, delete: if isAdmin();
    }

    match /admins/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isAdmin();
      allow write: if false;
    }

    match /test/connection {
      allow get: if true;